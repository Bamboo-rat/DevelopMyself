// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
  output   = "../prisma-client"
}

datasource db {
  provider = "postgresql"
}

// ===================== Enums =====================

enum UserStatus {
  ACTIVE
  INACTIVE

  @@map("user_status")
}

enum PageType {
  NOTE
  GOAL
  PROJECT
  JOURNAL
  ROADMAP
  TASK_LIST
  KNOWLEDGE

  @@map("page_type")
}

enum PageKind {
  DOCUMENT
  FOLDER

  @@map("page_kind")
}

// ===================== Models =====================

model User {
  id           String     @id @default(uuid()) @db.Uuid
  email        String     @unique @db.VarChar(255)
  passwordHash String     @map("password_hash")
  fullName     String?    @map("full_name") @db.VarChar(255)
  avatarUrl    String?    @map("avatar_url")
  status       UserStatus @default(ACTIVE)
  lastLoginAt  DateTime?  @map("last_login_at")
  createdAt    DateTime   @default(now()) @map("created_at")
  updatedAt    DateTime   @updatedAt @map("updated_at")

  pages         Page[]
  pageTemplates PageTemplate[]

  @@index([email], name: "idx_users_email")
  @@map("users")
}

model Page {
  id         String    @id @default(uuid()) @db.Uuid
  userId     String    @map("user_id") @db.Uuid
  parentId   String?   @map("parent_id") @db.Uuid
  title      String    @db.VarChar(255)
  content    Json      @default("{}")
  icon       String?   @db.VarChar(100)
  coverUrl   String?   @map("cover_url")
  pageType   PageType  @default(NOTE) @map("page_type")
  pageKind   PageKind? @map("page_kind")
  sortOrder  Int       @default(0) @map("sort_order")
  depth      Int       @default(0)
  path       String?
  isFavorite Boolean   @default(false) @map("is_favorite")
  isArchived Boolean   @default(false) @map("is_archived")
  isDeleted  Boolean   @default(false) @map("is_deleted")
  deletedAt  DateTime? @map("deleted_at")
  createdAt  DateTime  @default(now()) @map("created_at")
  updatedAt  DateTime  @updatedAt @map("updated_at")

  user     User   @relation(fields: [userId], references: [id])
  parent   Page?  @relation("PageChildren", fields: [parentId], references: [id])
  children Page[] @relation("PageChildren")

  @@index([userId], name: "idx_pages_user_id")
  @@index([parentId], name: "idx_pages_parent_id")
  @@index([userId, parentId], name: "idx_pages_user_parent")
  @@index([userId, isDeleted], name: "idx_pages_user_deleted")
  @@index([userId, isFavorite], name: "idx_pages_user_favorite")
  @@index([pageType], name: "idx_pages_type")
  @@map("pages")
}

model PageTemplate {
  id             String   @id @default(uuid()) @db.Uuid
  userId         String?  @map("user_id") @db.Uuid
  name           String   @db.VarChar(255)
  description    String?
  pageType       PageType @map("page_type")
  defaultContent Json     @default("{}") @map("default_content")
  isSystem       Boolean  @default(false) @map("is_system")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  user User? @relation(fields: [userId], references: [id])

  @@index([userId], name: "idx_page_templates_user_id")
  @@index([pageType], name: "idx_page_templates_type")
  @@map("page_templates")
}
